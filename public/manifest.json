{
  "id": "/",
  "name": "Beu Verify - Smart Bank Receipt & SMS Verification",
  "short_name": "BeuVerify",
  "description": "Secure bank receipt verification platform for Ethiopian banks (CBE, Telebirr, BOA, Dashen) with real-time QR code scanning, SMS verification, and fraud detection.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070709",
  "theme_color": "#FFD700",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "business", "utilities"],
  "iarc_rating_id": "e84b0754-72b6-418b-ae04-2b2829286d11",
  "prefer_related_applications": false,
  "screenshots": [
    {
      "src": "/screenshot-mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile receipt verification screen"
    },
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop analytics & verification dashboard"
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "share_target": {
    "action": "/?action=share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/?action=file",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "application/pdf": [".pdf"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+beuverify",
      "url": "/?verify=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "shortcuts": [
    {
      "name": "Scan Receipt",
      "short_name": "Scan",
      "description": "Scan a bank receipt QR code instantly",
      "url": "/?action=scan",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Verify SMS",
      "short_name": "Verify SMS",
      "description": "Verify bank notification SMS",
      "url": "/?action=sms",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}

